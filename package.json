{
  "name": "matemko",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:worker": "wrangler d1 migrations apply easymath --local && wrangler dev",
    "build": "node scripts/migrations.mjs && vite build",
    "test": "node scripts/migrations.mjs --check && node --test tests/*.test.js",
    "deploy": "npm run build && wrangler d1 migrations apply easymath --remote && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.156.0",
    "vite": "7.1.9",
    "@vitejs/plugin-vue": "6.0.1"
  },
  "type": "module",
  "dependencies": {
    "vue": "3.5.22",
    "lucide-vue-next": "0.468.0",
    "@fontsource-variable/dm-sans": "^5.2.6"
  }
}
