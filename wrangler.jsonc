{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maths",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  // Sender for verification and password-reset emails (domain must be verified in Resend).
  // RESEND_API_KEY is a secret: set it with `npx wrangler secret put RESEND_API_KEY`.
  "vars": {
    "MAIL_FROM": "Easy Math <hello@ricnovasoftware.com>",
    // Platform admins (comma separated). They must also have confirmed their email.
    "ADMIN_EMAILS": "r.kipsang@gmail.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "easymath",
      "database_id": "451e1ad5-16c8-403e-a8d0-f7e3cda5ec9d",
      "migrations_dir": "migrations"
    }
  ]
}
